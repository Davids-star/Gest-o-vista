# ============================================================
# MODELO DO .env (copie para ".env" e preencha). Nada aqui é segredo.
# Senhas de usuário NÃO vão neste arquivo: o cadastro pede no terminal.
# ============================================================

# ── BANCO ───────────────────────────────────────────────────
# Produção (Render): use DATABASE_URL com o host DIRETO do Neon (sem -pooler).
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST/NOME?sslmode=require
# Local: use as variáveis separadas abaixo.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=TROQUE-AQUI
DB_NAME=sistema_producao
DB_SSL=false

# ── API ─────────────────────────────────────────────────────
# NÃO defina PORT no Render (a plataforma escolhe a porta sozinha).
JWT_SECRET=TROQUE-AQUI-POR-UMA-CHAVE-LONGA
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MQTT_HOST=localhost
MQTT_PORT=1883
STOP_DETECTION_SECONDS=120
STOP_DETECTOR_POLL_INTERVAL_MS=15000
# Só para desenvolvimento local (nunca no Render):
MODO_LOCAL_SEM_TOKEN=true

# ── FRONTEND (vão para o navegador/APK: nunca coloque segredo aqui) ──
VITE_API_URL=
VITE_SENSOR_MODE=auto
VITE_BLUETOOTH_DEVICE_NAME=HC-06
VITE_SYNC_INTERVAL_MS=5000
VITE_SYNC_WINDOW_MS=5000
# Aparelho (APK/Totem). Vêm do cadastro do dispositivo, não de usuário:
# VITE_DEVICE_ID=TOTEM-MQ-01
# VITE_DEVICE_TOKEN=COLE-O-RAW_TOKEN-DO-DISPOSITIVO

# ── PONTE DO CABO (simulator/serve.py) ─────────────────────
# Defina no terminal ao rodar a ponte, em vez de gravar aqui:
# GP_API_URL=https://SUA-API.onrender.com
# GP_DEVICE_TOKEN=COLE-O-RAW_TOKEN-DO-DISPOSITIVO
# GP_MACHINE_CODE=MQ-01
