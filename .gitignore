# Cada um destes já é seu próprio projeto/repositório independente — a raiz
# não versiona o conteúdo deles, só coordena via README.

/codex-plugin-antigravity/

# Tooling de agentes (Claude Code / Codex), não faz parte do produto GP
/.agents/
/.claude/
/.codex_home/
/.codex-plugin-antigravity/

# Node
node_modules/
dist/
dist-ssr/
dev-dist/
npm-debug.log*

# Python
__pycache__/
*.pyc

# Fila local do simulator/serve.py — dado de execução (eventos pendentes de
# envio), não é código nem deve ser versionado
simulator/fila_eventos.jsonl

# Segredos e dados locais
*.env
.env
.env.*
!*.env.example

# Certificado HTTPS local (mkcert) pra testar o PWA num celular real na
# mesma rede Wi-Fi — específico de cada máquina/IP, nunca deve ser
# versionado (compartilhado entre api/ e frontend/, peça ajuda pra
# regenerar se mudar de máquina/IP).
/.certs/

# Editor / SO
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
