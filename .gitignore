# Cada um destes já é seu próprio projeto/repositório independente — a raiz
# não versiona o conteúdo deles, só coordena via README.

/codex-plugin-antigravity/

# Tooling de agentes (Claude Code / Codex), não faz parte do produto GP
/.agents/
/.claude/
/.codex_home/
/.codex-plugin-antigravity/

# Node
node_modules/
dist/
dist-ssr/
dev-dist/
npm-debug.log*

# Python
__pycache__/
*.pyc

# Fila local do simulator/serve.py — dado de execução (eventos pendentes de
# envio), não é código nem deve ser versionado
simulator/fila_eventos.jsonl

# Segredos e dados locais
*.env
.env
.env.*
!*.env.example

# Certificado HTTPS local (mkcert) gerado numa tentativa anterior (revertida)
# de testar PWA no Android — contém chave privada, nunca deve ser versionado.
/.certs/

# Editor / SO
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
